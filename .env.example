# =============================================================================
# HerTurn Frontend Environment Configuration Template (Staging & Production)
# Placeholders only. NEVER commit credentials or sensitive values.
# =============================================================================

# API Base URL for backend communication:
# - In local development with Vite proxy: 'http://localhost:8000' or '/api'
# - In staging deployment: 'https://api-staging.herturn.app'
# - In production deployment: 'https://api.herturn.app'
VITE_API_BASE_URL=https://api-staging.herturn.app

# Demo / Mock Mode Flag:
# - MUST be 'false' in staging and production to communicate with the live backend.
# - Can be 'true' only for isolated offline UI testing without a running backend.
VITE_USE_MOCK=false
