# =============================================================================
# HerTurn Backend Environment Configuration Template (Staging & Production)
# IMPORTANT: Placeholders only. NEVER commit real API keys, secrets, or passwords.
# =============================================================================

# Server Environment & Network
HOST=0.0.0.0
PORT=8000
# Set to 'staging' or 'production' in deployed environments (enforces security rules)
ENVIRONMENT=staging

# Cross-Origin Resource Sharing (CORS)
# In 'production' and 'staging', comma-separated list of allowed frontend origins.
# Example: https://staging.herturn.app,https://herturn.app
# In development, localhost origins (5173, 3000) are automatically permitted.
ALLOWED_ORIGINS=https://staging.herturn.app

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Use a production project with billing/quota enabled to prevent 503 demand throttling.
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Recommended Gemini Model ID:
# Options: gemini-flash-latest, gemini-3.1-flash-lite-preview, gemini-3.8-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-flash-latest

# Upstream request timeout in seconds (prevents socket hangs on network degradation)
GEMINI_TIMEOUT_SECONDS=30.0

# Database Configuration
# Staging/Production: Managed PostgreSQL connection string
# Format: postgresql://<user>:<password>@<db-host>:<port>/<database-name>
# Development/Sandbox default: sqlite:///./herturn.db
DATABASE_URL=sqlite:///./herturn.db

# ChromaDB Vector Store Persistence
# CRITICAL FOR CONTAINERS: In Docker/ECS/Cloud Run/Kubernetes, point to a mounted
# persistent volume to preserve vector index across container restarts.
# Example: /mnt/data/chroma_db
CHROMA_PERSIST_DIR=./chroma_db

# Authentication & Security
# CRITICAL: In production (ENVIRONMENT=production), JWT_SECRET_KEY MUST be at least 32 characters.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_key_min_32_chars

# Access Token Validity in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
